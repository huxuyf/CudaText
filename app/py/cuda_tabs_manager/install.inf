[info]
title=标签管理
desc=标签页列表、重开关闭标签、中键关闭标签
type=cudatext-plugin
subdir=cuda_tabs_manager
api=1.0.482
homepage=

[item1]
section=events
events=on_focus,on_open,on_tab_move,on_state_ed,on_close_pre,on_close,on_start2,on_state,on_exit_pre,on_cli

[item2]
section=commands
caption=标签管理\标签页列表
method=open

[item3]
section=commands
caption=标签管理\标签页列表（聚焦过滤框）
method=open_filter

[item4]
section=commands
caption=标签管理\标签页列表设置
method=list_config
menu=o

[item5]
section=commands
caption=标签管理\重开最近关闭的标签
method=reopen_last

[item6]
section=commands
caption=标签管理\从列表重开...
method=reopen_list

[item7]
section=commands
caption=标签管理\清空最近关闭列表
method=clear_list

[item8]
section=commands
caption=标签管理\重开设置
method=reopen_config
menu=o

[item9]
section=commands
caption=标签管理\重新挂接标签栏
method=rescan

[sidebar1]
hint=Tabs
icon=tabs.png
method=open
