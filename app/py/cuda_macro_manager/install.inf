[info]
title=宏管理
desc=命名保存、列出、回放、删除 CudaText 核心录制的宏
type=cudatext-plugin
subdir=cuda_macro_manager
api=1.0.482
homepage=

[item1]
section=events
events=on_macro

[item2]
section=commands
caption=宏\开始 / 停止录制
method=start_stop

[item3]
section=commands
caption=宏\保存最近录制...
method=save_last

[item4]
section=commands
caption=宏\回放最近录制
method=play_last

[item5]
section=commands
caption=宏\宏列表与回放...
method=list

[item6]
section=commands
caption=宏\删除宏...
method=delete

[item7]
section=commands
caption=宏\显示宏库路径
method=show_path
